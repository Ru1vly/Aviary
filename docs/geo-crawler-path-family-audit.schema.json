{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-crawler-path-family-audit.schema.json",
  "title": "Aviary GEO crawler route-family audit correlation",
  "type": "object",
  "required": ["source", "schemaVersion", "rows"],
  "properties": {
    "source": { "const": "Aviary AI crawler route-family audit correlation" },
    "schemaVersion": { "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analysis_index", "crawler_token", "path_family", "retained_requests"],
        "properties": {
          "analysis_index": { "type": "integer", "minimum": 1 },
          "source_file": { "type": ["string", "null"] },
          "origin": { "type": "string", "format": "uri" },
          "audit_timestamp": { "type": "string", "format": "date-time" },
          "crawler_token": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "activity": { "type": ["string", "null"] },
          "path_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
          "path_family": { "type": "string" },
          "retained_paths": { "type": "integer", "minimum": 0 },
          "retained_requests": { "type": "integer", "minimum": 0 },
          "matched_audit_requests": { "type": "integer", "minimum": 0 },
          "question_heading_request_share_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "weighted_mean_question_headings_per_observed_request": { "type": ["number", "null"], "minimum": 0 },
          "review_signal_request_counts": { "type": ["object", "null"], "additionalProperties": { "type": "integer", "minimum": 0 } },
          "crawler_path_catalog_truncated": { "type": ["boolean", "null"] },
          "audit_path_observations_truncated": { "type": ["boolean", "null"] },
          "output_rows_truncated": { "type": ["boolean", "null"] },
          "interpretation_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
