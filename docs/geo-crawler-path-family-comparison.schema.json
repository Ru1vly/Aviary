{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-crawler-path-family-comparison.schema.json",
  "title": "Aviary GEO crawler route-family period comparison",
  "type": "object",
  "required": ["source", "schemaVersion", "rows"],
  "properties": {
    "source": { "const": "Aviary AI crawler route-family period comparison" },
    "schemaVersion": { "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analysis_index", "crawler_token", "path_family", "change_state"],
        "properties": {
          "analysis_index": { "type": "integer", "minimum": 0 },
          "crawler_token": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "activity": { "type": ["string", "null"] },
          "path_depth": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "path_family": { "type": "string" },
          "change_state": { "enum": ["matched-retained", "baseline-only-retained", "current-only-retained"] },
          "baseline_requests": { "type": ["number", "null"], "minimum": 0 },
          "current_requests": { "type": ["number", "null"], "minimum": 0 },
          "request_delta_on_matched_family": { "type": ["number", "null"] },
          "baseline_failure_rate_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "current_failure_rate_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "baseline_output_rows_truncated": { "type": ["boolean", "null"] },
          "current_output_rows_truncated": { "type": ["boolean", "null"] },
          "comparison_rows_truncated": { "type": ["boolean", "null"] },
          "interpretation_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
