{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-crawler-path-family-audit-comparison.schema.json",
  "title": "Aviary GEO crawler route-family paired audit comparison",
  "type": "object",
  "required": ["source", "schemaVersion", "rows"],
  "properties": {
    "source": { "const": "Aviary AI crawler route-family paired audit comparison" },
    "schemaVersion": { "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analysis_index", "crawler_token", "path_family", "paired_exact_audit_matched_paths"],
        "properties": {
          "analysis_index": { "type": "integer", "minimum": 0 },
          "crawler_token": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "activity": { "type": ["string", "null"] },
          "path_depth": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "path_family": { "type": "string" },
          "shared_exact_paths": { "type": ["integer", "null"], "minimum": 0 },
          "paired_exact_audit_matched_paths": { "type": ["integer", "null"], "minimum": 0 },
          "baseline_requests_on_shared_paths": { "type": ["number", "null"], "minimum": 0 },
          "current_requests_on_shared_paths": { "type": ["number", "null"], "minimum": 0 },
          "baseline_crawler_path_catalog_truncated": { "type": ["boolean", "null"] },
          "current_crawler_path_catalog_truncated": { "type": ["boolean", "null"] },
          "baseline_audit_path_observations_truncated": { "type": ["boolean", "null"] },
          "current_audit_path_observations_truncated": { "type": ["boolean", "null"] },
          "output_rows_truncated": { "type": ["boolean", "null"] },
          "interpretation_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
