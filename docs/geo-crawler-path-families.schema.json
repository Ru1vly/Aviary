{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-crawler-path-families.schema.json",
  "title": "Aviary GEO crawler route-family inventory",
  "type": "object",
  "required": ["source", "schemaVersion", "rows"],
  "properties": {
    "source": { "const": "Aviary AI crawler route-family inventory" },
    "schemaVersion": { "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analysis_index", "crawler_token", "path_family", "family_requests"],
        "properties": {
          "analysis_index": { "type": "integer", "minimum": 1 },
          "source_file": { "type": ["string", "null"] },
          "crawler_token": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "activity": { "type": ["string", "null"] },
          "path_depth": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "path_family": { "type": "string" },
          "family_requests": { "type": "number", "minimum": 0 },
          "failure_rate_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "status_codes": { "type": ["array", "null"], "items": { "type": "object" } },
          "response_content_types": { "type": ["array", "null"], "items": { "type": "object" } },
          "sample_paths": { "type": ["array", "null"], "items": { "type": "object" }, "maxItems": 10 },
          "status_codes_truncated": { "type": ["boolean", "null"] },
          "response_content_types_truncated": { "type": ["boolean", "null"] },
          "crawler_paths_truncated": { "type": ["boolean", "null"] },
          "output_rows_truncated": { "type": ["boolean", "null"] },
          "interpretation_note": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
