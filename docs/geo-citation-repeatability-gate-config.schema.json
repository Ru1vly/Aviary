{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-citation-repeatability-gate-config.schema.json",
  "title": "Aviary GEO Citation Repeatability Gate Configuration",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "metric", "maxDecline", "minimumComparablePrompts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$" },
          "provider": { "type": "string", "maxLength": 500 },
          "model": { "type": "string", "maxLength": 500 },
          "surface": { "type": "string", "maxLength": 500 },
          "locale": { "type": "string", "maxLength": 500 },
          "topic": { "type": "string", "maxLength": 500 },
          "intent": { "type": "string", "maxLength": 500 },
          "metric": { "enum": ["citationSetJaccard", "topThreeJaccard", "citationDomainJaccard", "topThreeDomainJaccard", "citationUrlRboP90", "citationDomainRboP90", "ownedCitationPresenceAgreement", "ownedFirstPositionPersistence"] },
          "maxDecline": { "type": "number", "minimum": 0, "maximum": 1, "description": "Maximum tolerable decrease on the metric's 0–1 scale. 0.15 represents 15 percentage points." },
          "minimumComparablePrompts": { "type": "integer", "minimum": 2, "maximum": 200000 },
          "requireHolmSignTest": { "type": "boolean", "description": "Also require this row's report-wide Holm-adjusted exact sign-test p-value to meet alpha." },
          "alpha": { "type": "number", "minimum": 0, "maximum": 1, "description": "Holm-adjusted sign-test alpha; valid only when requireHolmSignTest is true, defaults to 0.05." }
        },
        "allOf": [
          {
            "if": { "properties": { "alpha": { "type": "number" } }, "required": ["alpha"] },
            "then": { "properties": { "requireHolmSignTest": { "const": true } }, "required": ["requireHolmSignTest"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
