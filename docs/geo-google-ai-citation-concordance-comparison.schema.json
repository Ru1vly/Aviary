{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-google-ai-citation-concordance-comparison.schema.json",
  "title": "Aviary Google AI citation concordance comparison",
  "description": "Descriptive comparison of page URL states and separate Google AI impression and observed answer citation measures across two saved concordance periods.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source", "schemaVersion", "googleAiSurface", "baselineAuditCanonicalBridgeAvailable",
    "currentAuditCanonicalBridgeAvailable", "ownedDomainAssessmentEnabled", "baselineAnswerObservations",
    "baselineProviderMetricCountsAvailable", "currentProviderMetricCountsAvailable",
    "baselineAnswerProviderSamplesAvailable", "currentAnswerProviderSamplesAvailable",
    "currentAnswerObservations", "baselineIncompleteCitationListObservations", "currentIncompleteCitationListObservations",
    "baselineAnswerCitationSourcePages", "currentAnswerCitationSourcePages", "baselineAnswerCitationPagesTruncated",
    "currentAnswerCitationPagesTruncated", "baselineGoogleAiUniquePages", "currentGoogleAiUniquePages",
    "baselineAnswerCitationEvents", "currentAnswerCitationEvents", "baselineAnswerCitationEventsInRetainedPages",
    "currentAnswerCitationEventsInRetainedPages", "baselineAnswerCitationEventDetailCoveragePercent",
    "currentAnswerCitationEventDetailCoveragePercent", "baselineMatchedCitationEventShareOfAllAnswerEventsPercent",
    "currentMatchedCitationEventShareOfAllAnswerEventsPercent",
    "baselineGoogleAiPageImpressions", "currentGoogleAiPageImpressions", "googleAiPageImpressionsChange",
    "baselineMatchedPages", "currentMatchedPages", "matchedPagesChange", "baselineMatchedImpressionSharePercent",
    "currentMatchedImpressionSharePercent", "matchedImpressionShareChangePercentagePoints",
    "baselineMatchedCitationEvents", "currentMatchedCitationEvents", "matchedCitationEventsChange",
    "baselineMatchedPageAnswerPairs", "currentMatchedPageAnswerPairs", "matchedPageAnswerPairsChange",
    "baselineMatchedPagePromptPairs", "currentMatchedPagePromptPairs", "matchedPagePromptPairsChange",
    "disappearedPages", "appearedPages", "newlyMatchedPages", "lostMatchPages", "rows", "providerChanges", "providerSampleChanges", "note"
  ],
  "properties": {
    "source": { "const": "Google AI citation concordance period comparison" },
    "schemaVersion": { "const": 1 },
    "googleAiSurface": { "enum": ["search", "discover"] },
    "baselineGoogleAiSourceFile": { "type": "string" },
    "currentGoogleAiSourceFile": { "type": "string" },
    "baselineAuditCanonicalBridgeAvailable": { "type": "boolean" },
    "currentAuditCanonicalBridgeAvailable": { "type": "boolean" },
    "ownedDomainAssessmentEnabled": { "type": "boolean" },
    "baselineProviderMetricCountsAvailable": { "type": "boolean" },
    "currentProviderMetricCountsAvailable": { "type": "boolean" },
    "baselineAnswerProviderSamplesAvailable": { "type": "boolean" },
    "currentAnswerProviderSamplesAvailable": { "type": "boolean" },
    "baselineAnswerObservations": { "type": "integer", "minimum": 0 },
    "currentAnswerObservations": { "type": "integer", "minimum": 0 },
    "baselineIncompleteCitationListObservations": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "currentIncompleteCitationListObservations": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "baselineAnswerCitationSourcePages": { "type": "integer", "minimum": 0 },
    "currentAnswerCitationSourcePages": { "type": "integer", "minimum": 0 },
    "baselineAnswerCitationPagesTruncated": { "type": "boolean" },
    "currentAnswerCitationPagesTruncated": { "type": "boolean" },
    "baselineAnswerCitationEvents": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "currentAnswerCitationEvents": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "baselineAnswerCitationEventsInRetainedPages": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "currentAnswerCitationEventsInRetainedPages": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "baselineAnswerCitationEventDetailCoveragePercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "currentAnswerCitationEventDetailCoveragePercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "baselineMatchedCitationEventShareOfAllAnswerEventsPercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "currentMatchedCitationEventShareOfAllAnswerEventsPercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "baselineGoogleAiUniquePages": { "type": "integer", "minimum": 0 },
    "currentGoogleAiUniquePages": { "type": "integer", "minimum": 0 },
    "baselineGoogleAiPageImpressions": { "type": "integer", "minimum": 0 },
    "currentGoogleAiPageImpressions": { "type": "integer", "minimum": 0 },
    "googleAiPageImpressionsChange": { "type": "integer" },
    "baselineMatchedPages": { "type": "integer", "minimum": 0 },
    "currentMatchedPages": { "type": "integer", "minimum": 0 },
    "matchedPagesChange": { "type": "integer" },
    "baselineMatchedImpressionSharePercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "currentMatchedImpressionSharePercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
    "matchedImpressionShareChangePercentagePoints": { "oneOf": [{ "type": "number", "minimum": -100, "maximum": 100 }, { "type": "null" }] },
    "baselineMatchedCitationEvents": { "type": "integer", "minimum": 0 },
    "currentMatchedCitationEvents": { "type": "integer", "minimum": 0 },
    "matchedCitationEventsChange": { "type": "integer" },
    "baselineMatchedPageAnswerPairs": { "type": "integer", "minimum": 0 },
    "currentMatchedPageAnswerPairs": { "type": "integer", "minimum": 0 },
    "matchedPageAnswerPairsChange": { "type": "integer" },
    "baselineMatchedPagePromptPairs": { "type": "integer", "minimum": 0 },
    "currentMatchedPagePromptPairs": { "type": "integer", "minimum": 0 },
    "matchedPagePromptPairsChange": { "type": "integer" },
    "disappearedPages": { "type": "integer", "minimum": 0 },
    "appearedPages": { "type": "integer", "minimum": 0 },
    "newlyMatchedPages": { "type": "integer", "minimum": 0 },
    "lostMatchPages": { "type": "integer", "minimum": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "transition"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "transition": { "enum": ["matched-both", "newly-matched", "lost-match", "appeared", "disappeared", "unchanged-unmatched", "changed-unmatched"] },
          "baselineJoinState": { "enum": ["matched", "google-ai-only", "observed-answer-only"] },
          "currentJoinState": { "enum": ["matched", "google-ai-only", "observed-answer-only"] },
          "baselineJoinMethod": { "enum": ["exact-normalized-url", "audit-canonical"] },
          "currentJoinMethod": { "enum": ["exact-normalized-url", "audit-canonical"] },
          "baselineAmbiguousAuditCanonical": { "type": "boolean" },
          "currentAmbiguousAuditCanonical": { "type": "boolean" },
          "baselineGoogleAiImpressions": { "type": "integer", "minimum": 0 },
          "currentGoogleAiImpressions": { "type": "integer", "minimum": 0 },
          "googleAiImpressionsChange": { "type": "integer" },
          "baselineCitationEvents": { "type": "integer", "minimum": 0 },
          "currentCitationEvents": { "type": "integer", "minimum": 0 },
          "citationEventsChange": { "type": "integer" },
          "baselinePageAnswerPairs": { "type": "integer", "minimum": 0 },
          "currentPageAnswerPairs": { "type": "integer", "minimum": 0 },
          "pageAnswerPairsChange": { "type": "integer" },
          "baselinePagePromptPairs": { "type": "integer", "minimum": 0 },
          "currentPagePromptPairs": { "type": "integer", "minimum": 0 },
          "pagePromptPairsChange": { "type": "integer" },
          "baselineOwned": { "type": "boolean" },
          "currentOwned": { "type": "boolean" }
        }
      }
    },
    "providerChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "provider", "detailState"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "provider": { "type": "string" },
          "detailState": { "enum": ["present-both", "baseline-detail-only", "current-detail-only"] },
          "baselineJoinState": { "enum": ["matched", "google-ai-only", "observed-answer-only"] },
          "currentJoinState": { "enum": ["matched", "google-ai-only", "observed-answer-only"] },
          "baselineJoinMethod": { "enum": ["exact-normalized-url", "audit-canonical"] },
          "currentJoinMethod": { "enum": ["exact-normalized-url", "audit-canonical"] },
          "baselineAmbiguousAuditCanonical": { "type": "boolean" },
          "currentAmbiguousAuditCanonical": { "type": "boolean" },
          "baselineCitationEvents": { "type": "integer", "minimum": 0 },
          "currentCitationEvents": { "type": "integer", "minimum": 0 },
          "citationEventsChange": { "type": "integer" },
          "baselinePageAnswerPairs": { "type": "integer", "minimum": 0 },
          "currentPageAnswerPairs": { "type": "integer", "minimum": 0 },
          "pageAnswerPairsChange": { "type": "integer" },
          "baselinePagePromptPairs": { "type": "integer", "minimum": 0 },
          "currentPagePromptPairs": { "type": "integer", "minimum": 0 },
          "pagePromptPairsChange": { "type": "integer" }
        }
      }
    },
    "providerSampleChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "detailState"],
        "properties": {
          "provider": { "type": "string" },
          "detailState": { "enum": ["present-both", "baseline-detail-only", "current-detail-only"] },
          "baselineObservations": { "type": "integer", "minimum": 0 },
          "currentObservations": { "type": "integer", "minimum": 0 },
          "observationsChange": { "type": "integer" },
          "baselineUniquePrompts": { "type": "integer", "minimum": 0 },
          "currentUniquePrompts": { "type": "integer", "minimum": 0 },
          "uniquePromptsChange": { "type": "integer" },
          "baselineCitationEvents": { "type": "integer", "minimum": 0 },
          "currentCitationEvents": { "type": "integer", "minimum": 0 },
          "citationEventsChange": { "type": "integer" },
          "baselineIncompleteCitationListObservations": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "currentIncompleteCitationListObservations": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
        }
      }
    },
    "note": { "type": "string" }
  }
}
