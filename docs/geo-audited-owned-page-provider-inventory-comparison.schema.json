{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ru1vly/Aviary/blob/main/docs/geo-audited-owned-page-provider-inventory-comparison.schema.json",
  "title": "Aviary audited owned-page/provider GEO comparison",
  "description": "Typed baseline/current answer-citation and sitewide GEO audit crosswalk. Blank comparison metrics are null when evidence is unknown, incomplete, or capped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineAuditTimestamp",
    "currentAuditTimestamp",
    "summary",
    "rows",
    "note"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineAuditTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "currentAuditTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "comparableRows",
        "newlyObservedCitationRows",
        "notObservedCurrentRows",
        "unknownOrOneSidedRows",
        "canonicalUrlChangedRows",
        "canonicalUrlUnknownRows",
        "searchCrawlerAccessChangedRows",
        "searchCrawlerAccessUnknownRows",
        "searchCrawlerAccessUnpairedRows",
        "dataUseCrawlerPolicyChangedRows",
        "dataUseCrawlerPolicyUnknownRows",
        "dataUseCrawlerPolicyUnpairedRows",
        "dataUseNoArchiveChangedRows",
        "dataUseNoArchiveUnknownRows",
        "dataUseNoArchiveUnpairedRows",
        "userInitiatedFetchChangedRows",
        "userInitiatedFetchUnknownRows",
        "userInitiatedFetchUnpairedRows",
        "optionalLlmsFilesChangedRows",
        "optionalLlmsFilesUnknownRows",
        "optionalLlmsFilesUnpairedRows",
        "httpResponseStatusChangedRows",
        "httpResponseStatusUnknownRows",
        "answerMetadataEvidenceChangedRows",
        "answerMetadataEvidenceUnknownRows",
        "dataNoSnippetWordsChangedRows",
        "dataNoSnippetWordShareChangedRows",
        "baselineInventoryTruncated",
        "currentInventoryTruncated",
        "comparisonRowsTruncated"
      ],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "comparableRows": { "type": "integer", "minimum": 0 },
        "newlyObservedCitationRows": { "type": "integer", "minimum": 0 },
        "notObservedCurrentRows": { "type": "integer", "minimum": 0 },
        "unknownOrOneSidedRows": { "type": "integer", "minimum": 0 },
        "canonicalUrlChangedRows": { "type": "integer", "minimum": 0 },
        "canonicalUrlUnknownRows": { "type": "integer", "minimum": 0 },
        "searchCrawlerAccessChangedRows": { "type": "integer", "minimum": 0 },
        "searchCrawlerAccessUnknownRows": { "type": "integer", "minimum": 0 },
        "searchCrawlerAccessUnpairedRows": { "type": "integer", "minimum": 0 },
        "dataUseCrawlerPolicyChangedRows": { "type": "integer", "minimum": 0 },
        "dataUseCrawlerPolicyUnknownRows": { "type": "integer", "minimum": 0 },
        "dataUseCrawlerPolicyUnpairedRows": { "type": "integer", "minimum": 0 },
        "dataUseNoArchiveChangedRows": { "type": "integer", "minimum": 0 },
        "dataUseNoArchiveUnknownRows": { "type": "integer", "minimum": 0 },
        "dataUseNoArchiveUnpairedRows": { "type": "integer", "minimum": 0 },
        "userInitiatedFetchChangedRows": { "type": "integer", "minimum": 0 },
        "userInitiatedFetchUnknownRows": { "type": "integer", "minimum": 0 },
        "userInitiatedFetchUnpairedRows": { "type": "integer", "minimum": 0 },
        "optionalLlmsFilesChangedRows": { "type": "integer", "minimum": 0 },
        "optionalLlmsFilesUnknownRows": { "type": "integer", "minimum": 0 },
        "optionalLlmsFilesUnpairedRows": { "type": "integer", "minimum": 0 },
        "httpResponseStatusChangedRows": { "type": "integer", "minimum": 0 },
        "httpResponseStatusUnknownRows": { "type": "integer", "minimum": 0 },
        "answerMetadataEvidenceChangedRows": { "type": "integer", "minimum": 0 },
        "answerMetadataEvidenceUnknownRows": { "type": "integer", "minimum": 0 },
        "dataNoSnippetWordsChangedRows": { "type": "integer", "minimum": 0 },
        "dataNoSnippetWordShareChangedRows": { "type": "integer", "minimum": 0 },
        "baselineInventoryTruncated": { "type": "boolean" },
        "currentInventoryTruncated": { "type": "boolean" },
        "comparisonRowsTruncated": { "type": "boolean" }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audited_owned_url", "provider", "page_provider_transition", "comparison_state",
          "baseline_audited_canonical_url", "audited_canonical_url", "canonical_url_transition",
          "baseline_http_response_status", "http_response_status", "http_response_status_transition",
          "baseline_data_nosnippet_words", "data_nosnippet_words", "data_nosnippet_words_change",
          "baseline_data_nosnippet_word_share_percent", "data_nosnippet_word_share_percent", "data_nosnippet_word_share_change",
          "baseline_data_use_crawler_policy_signal_coverage", "data_use_crawler_policy_signal_coverage",
          "baseline_data_use_crawler_policy", "data_use_crawler_policy", "data_use_crawler_policy_transition", "data_use_crawler_changed_common_tokens",
          "baseline_user_initiated_fetch_signal_coverage", "user_initiated_fetch_signal_coverage",
          "baseline_user_initiated_fetch_access", "user_initiated_fetch_access", "user_initiated_fetch_transition", "user_initiated_fetch_changed_common_tokens",
          "baseline_optional_llms_files_signal_coverage", "optional_llms_files_signal_coverage",
          "baseline_optional_llms_files", "optional_llms_files", "optional_llms_files_transition", "optional_llms_files_changed_common_paths",
          "baseline_data_use_noarchive_controls", "data_use_noarchive_controls", "data_use_noarchive_transition", "data_use_noarchive_changed_common_tokens",
          "baseline_visible_author", "visible_author", "visible_author_transition",
          "baseline_visible_date", "visible_date", "visible_date_transition",
          "baseline_schema_author", "schema_author", "schema_author_transition",
          "baseline_schema_date", "schema_date", "schema_date_transition",
          "baseline_schema_date_modified_has_non_date_value", "schema_date_modified_has_non_date_value", "schema_date_modified_value_transition",
          "baseline_schema_date_modified_values_truncated", "schema_date_modified_values_truncated", "schema_date_modified_truncation_transition"
        ],
        "properties": {
          "audited_owned_url": { "type": "string", "format": "uri" },
          "provider": { "type": "string", "minLength": 1 },
          "page_provider_transition": { "type": "string" },
          "comparison_state": { "type": "string" },
          "baseline_audited_canonical_url": { "type": ["string", "null"], "format": "uri" },
          "audited_canonical_url": { "type": ["string", "null"], "format": "uri" },
          "canonical_url_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_http_response_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "http_response_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "http_response_status_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_data_nosnippet_words": { "type": ["integer", "null"], "minimum": 0 },
          "data_nosnippet_words": { "type": ["integer", "null"], "minimum": 0 },
          "data_nosnippet_words_change": { "type": ["integer", "null"] },
          "baseline_data_nosnippet_word_share_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "data_nosnippet_word_share_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "data_nosnippet_word_share_change": { "type": ["number", "null"] },
          "data_use_crawler_changed_common_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "data_use_crawler_policy_transition": { "enum": ["changed", "unchanged", "unknown", "no-common-tokens"] },
          "data_use_noarchive_changed_common_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "data_use_noarchive_transition": { "enum": ["changed", "unchanged", "unknown", "no-common-tokens"] },
          "user_initiated_fetch_changed_common_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "user_initiated_fetch_transition": { "enum": ["changed", "unchanged", "unknown", "no-common-tokens"] },
          "optional_llms_files_changed_common_paths": { "type": ["integer", "null"], "minimum": 0 },
          "optional_llms_files_transition": { "enum": ["changed", "unchanged", "unknown", "no-common-paths"] },
          "baseline_visible_author": { "type": ["boolean", "null"] },
          "visible_author": { "type": ["boolean", "null"] },
          "visible_author_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_visible_date": { "type": ["boolean", "null"] },
          "visible_date": { "type": ["boolean", "null"] },
          "visible_date_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_schema_author": { "type": ["boolean", "null"] },
          "schema_author": { "type": ["boolean", "null"] },
          "schema_author_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_schema_date": { "type": ["boolean", "null"] },
          "schema_date": { "type": ["boolean", "null"] },
          "schema_date_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_schema_date_modified_has_non_date_value": { "type": ["boolean", "null"] },
          "schema_date_modified_has_non_date_value": { "type": ["boolean", "null"] },
          "schema_date_modified_value_transition": { "enum": ["changed", "unchanged", "unknown"] },
          "baseline_schema_date_modified_values_truncated": { "type": ["boolean", "null"] },
          "schema_date_modified_values_truncated": { "type": ["boolean", "null"] },
          "schema_date_modified_truncation_transition": { "enum": ["changed", "unchanged", "unknown"] }
        },
        "additionalProperties": {
          "type": ["string", "number", "boolean", "null"]
        }
      }
    },
    "note": { "type": "string", "minLength": 1 }
  }
}
