{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aviary.dev/schemas/geo-answer-review-bundle.schema.json",
  "title": "Aviary GEO Answer Review Bundle Manifest",
  "description": "Integrity and inventory metadata for files generated by the GEO answer review bundle example, excluding the manifest itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "generated_at_utc", "files"],
  "properties": {
    "artifact_type": { "const": "geo-answer-review-bundle" },
    "schema_version": { "const": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "media_type": { "enum": ["text/csv", "application/json", "text/html", "text/markdown"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
