# e2e-seo — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Target ────────────────────────────────────────────────────

# Target URL for SEO audit
E2E_SEO_URL=https://example.com

# ── Browser ───────────────────────────────────────────────────

# Run browser in headless mode (true/false)
E2E_SEO_HEADLESS=true

# Request timeout in milliseconds
E2E_SEO_TIMEOUT=30000

# Browser viewport size (WxH)
E2E_SEO_VIEWPORT=1920x1080

# ── Audit ─────────────────────────────────────────────────────

# Audit preset (basic/advanced/strict)
E2E_SEO_PRESET=advanced

# ── Output ────────────────────────────────────────────────────

# Save JSON report to file (empty = stdout only)
E2E_SEO_OUTPUT=

# Save HTML report to file (empty = skip)
E2E_SEO_HTML_OUTPUT=

# ── Logging ───────────────────────────────────────────────────

# Log level for stderr diagnostic output (silent/error/warn/info/debug)
E2E_SEO_LOG_LEVEL=info

# ── LLM Integration ───────────────────────────────────────────

# LLM provider: stub | ollama | openai
E2E_SEO_LLM_PROVIDER=stub

# Ollama endpoint (for local LLM)
E2E_SEO_LLM_ENDPOINT=http://localhost:11434

# Model name
E2E_SEO_LLM_MODEL=llama3.2

# API key (for OpenAI provider) — NEVER commit this value
E2E_SEO_LLM_API_KEY=
