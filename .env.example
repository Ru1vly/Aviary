# aviary — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Target ────────────────────────────────────────────────────

# Target URL for SEO audit
AVIARY_URL=https://example.com

# ── Browser ───────────────────────────────────────────────────

# Run browser in headless mode (true/false)
AVIARY_HEADLESS=true

# Request timeout in milliseconds — read by the TS CLI's Playwright
# navigation (src/config/env.ts). The Rust fast-path engine has its own,
# separate timeout — see AVIARY_TIMEOUT_MS below.
AVIARY_TIMEOUT=30000

# Browser viewport size (WxH)
AVIARY_VIEWPORT=1920x1080

# ── Audit ─────────────────────────────────────────────────────

# Audit preset (basic/advanced/strict)
AVIARY_PRESET=advanced

# ── Output ────────────────────────────────────────────────────

# Save JSON report to file (empty = stdout only)
AVIARY_OUTPUT=

# Save HTML report to file (empty = skip)
AVIARY_HTML_OUTPUT=

# ── Logging ───────────────────────────────────────────────────

# Log level for stderr diagnostic output (debug/info/warn/error)
AVIARY_LOG_LEVEL=info

# ── LLM Integration ───────────────────────────────────────────
# Read independently by both the TS CLI (src/config/env.ts — currently
# parsed but not consumed there) and the Rust engine's semantic analyzer
# (engine/src/semantic/factory.rs), which is where these actually take
# effect today.

# LLM provider: stub | ollama. Any other value (including "openai", which
# isn't implemented) silently falls back to the stub analyzer.
AVIARY_LLM_PROVIDER=stub

# Ollama endpoint (for local LLM)
AVIARY_LLM_ENDPOINT=http://localhost:11434

# Model name
AVIARY_LLM_MODEL=llama3.2

# API key — NEVER commit this value. Unused by the stub/ollama providers;
# reserved for a future provider that needs one.
AVIARY_LLM_API_KEY=

# ── Metrics ───────────────────────────────────────────────────

# Prometheus metrics endpoint port for the TS CLI's /metrics server
# (src/cli.ts). Default: 9090.
AVIARY_METRICS_PORT=9090

# ── Rust fast-path engine (engine/, used by the TUI's --fast mode) ─────
# These are read directly via std::env::var in engine/src/config.rs and
# engine/src/crawler/renderer.rs — separate from every AVIARY_* var above,
# which only the TS CLI reads.

# HTTP User-Agent for the Rust engine's plain-HTTP fetch.
AVIARY_USER_AGENT=Mozilla/5.0 (compatible; aviary-engine/0.1; +https://github.com/aviary)

# Timeout (ms) for the Rust engine's HTTP fetch. Distinct from AVIARY_TIMEOUT
# above, which only applies to the TS CLI's browser navigation.
AVIARY_TIMEOUT_MS=15000

# Timeout (ms) for a full Node-renderer round trip when the Rust engine
# falls back to the Node CLI for a detected SPA (launching Chromium and
# running the complete 28-checker Playwright audit takes far longer than
# a bare HTTP fetch).
AVIARY_RENDER_TIMEOUT_MS=60000

# Path to the Node CLI script, used to locate the SPA-fallback worker
# (dist/worker.js is resolved relative to this path).
AVIARY_NODE_CLI=dist/cli.js

# Whether the Rust engine automatically falls back to the Node renderer
# when a fetched page looks like a JS-rendered SPA (true/false).
AVIARY_AUTO_RENDER=true
