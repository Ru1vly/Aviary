# aviary — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Target ────────────────────────────────────────────────────

# Target URL for SEO audit
AVIARY_URL=https://example.com

# ── Browser ───────────────────────────────────────────────────

# Run browser in headless mode (true/false)
AVIARY_HEADLESS=true

# Request timeout in milliseconds
AVIARY_TIMEOUT=30000

# Browser viewport size (WxH)
AVIARY_VIEWPORT=1920x1080

# ── Audit ─────────────────────────────────────────────────────

# Audit preset (basic/advanced/strict)
AVIARY_PRESET=advanced

# ── Output ────────────────────────────────────────────────────

# Save JSON report to file (empty = stdout only)
AVIARY_OUTPUT=

# Save HTML report to file (empty = skip)
AVIARY_HTML_OUTPUT=

# ── Logging ───────────────────────────────────────────────────

# Log level for stderr diagnostic output (silent/error/warn/info/debug)
AVIARY_LOG_LEVEL=info

# ── LLM Integration ───────────────────────────────────────────

# LLM provider: stub | ollama | openai
AVIARY_LLM_PROVIDER=stub

# Ollama endpoint (for local LLM)
AVIARY_LLM_ENDPOINT=http://localhost:11434

# Model name
AVIARY_LLM_MODEL=llama3.2

# API key (for OpenAI provider) — NEVER commit this value
AVIARY_LLM_API_KEY=

# ── Metrics & IPC ──────────────────────────────────────────────

# Prometheus metrics endpoint port (default: 9090)
AVIARY_METRICS_PORT=9090

# IPC socket path for TUI communication
AVIARY_IPC_PATH=/tmp/aviary.sock
