    "geo:prompt-plan:synthetic": "bash examples/geo-prompt-panel-plan.sh examples/geo-answer-observations.example.json reports/geo-prompt-panel-plan",
    "geo:page-opportunities:synthetic": "bash examples/geo-page-opportunities.sh",
    "geo:page-opportunity-trends:synthetic": "bash examples/geo-page-opportunity-trends.sh",
    "geo:source-category-turnover:synthetic": "bash examples/geo-source-category-monthly-turnover.sh",
