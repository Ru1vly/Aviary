  "scripts": {
    "build": "node scripts/build.js",
    "build:ts": "tsc && node scripts/build-xlsx.js",
    "build:tui": "node scripts/build-tui.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:benchmark": "vitest bench",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:cli-docs": "node scripts/check-cli-option-docs.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "example": "npm run build:ts && tsx examples/basic-usage.ts",
    "geo:review": "bash examples/geo-answer-review-bundle.sh",
    "geo:review:verify": "bash examples/geo-answer-review-bundle-verify.sh",
    "geo:review:synthetic": "bash examples/geo-answer-review-bundle.synthetic.sh",
    "geo:repeatability": "node examples/geo-citation-repeatability.mjs",
    "geo:repeatability:synthetic": "bash examples/geo-citation-repeatability.synthetic.sh",
    "geo:repeatability:compare": "node examples/geo-citation-repeatability-compare.mjs",
    "geo:repeatability:gate": "node examples/geo-citation-repeatability-gate.mjs",
    "geo:panel:compare": "node examples/geo-panel-comparability.mjs",
    "geo:prompt-family": "bash examples/geo-prompt-family-sensitivity.sh",
    "geo:prompt-family:synthetic": "bash examples/geo-prompt-family-sensitivity.sh examples/geo-answer-observations.example.json reports/geo-prompt-family-sensitivity",
